#!/usr/bin/env node

const { spawnSync } = require('child_process');
const path = require('path');

const args = process.argv.slice(2);
const platformNames = {
  darwin: 'macOS',
  linux: 'Linux',
  win32: 'Windows',
};

if (process.platform !== 'darwin') {
  const detectedPlatform = platformNames[process.platform] || process.platform;
  console.error(
    `Error: airgrab is not available on ${detectedPlatform}. airgrab is only available on macOS.`
  );
  process.exit(1);
}

const binPath = path.join(__dirname, 'airgrab-bin');
const result = spawnSync(binPath, args, { stdio: 'inherit' });

if (result.error) {
  console.error(`Error executing process: ${result.error.message}`);
  process.exit(1);
}

if (result.signal) {
  console.error(`Process terminated by signal: ${result.signal}`);
  process.exit(128);
}

process.exit(result.status !== null ? result.status : 1);
